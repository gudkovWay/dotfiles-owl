#!/usr/bin/env bash
# qwen-serve — Qwen3.8-27B через llama-server с авто-подгонкой под свободную VRAM.
#
# Подгонку слоёв/контекста делает сам llama.cpp (--fit on + --fit-target):
# он смотрит на СВОБОДНУЮ память в момент старта и оставляет заданный запас.
# Скрипт задаёт профили, дефолты и показывает, что происходит.
#
#   qwen-serve                  обычный режим (запас 700 MiB, ctx 16k)
#   qwen-serve --game           рядом с Assetto Corsa (запас 7 ГБ)
#   qwen-serve --big            ctx 32k — больше контекста, ниже скорость
#   qwen-serve --vision         включить работу с картинками (~900 MiB VRAM)
#   qwen-serve --margin 3072    свой запас в MiB
#   qwen-serve --ctx 24576      свой контекст
#   qwen-serve --think off      без reasoning (быстрее ответ, хуже сложные задачи)
#   qwen-serve --router         режим роутера: обе модели в списке Zed,
#                               переключение прямо в селекторе, подгрузка по запросу
# Всё после -- уходит в llama-server как есть.

set -euo pipefail

MODEL_DIR="${QWEN_MODEL_DIR:-/home/q/storage/ai/models/llm}"
MODEL="${QWEN_MODEL:-$MODEL_DIR/Qwen3.8-27B-UD-IQ4_XS.gguf}"
MMPROJ="$MODEL_DIR/mmproj-F16.gguf"

MARGIN=700         # MiB свободной VRAM, которые не трогаем (--fit-target)
CTX=16384          # замерено как баланс скорости и контекста
VISION=0           # проектор стоит ~900 MiB VRAM = ~2 ток/с, по умолчанию выкл
THINK="auto"
EFFORT="default"
HOST="${QWEN_HOST:-127.0.0.1}"
PORT="${QWEN_PORT:-8080}"
ROUTER=0
PRESETS="${QWEN_PRESETS:-$HOME/.config/llama-cpp/models.ini}"
EXTRA=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --router)   ROUTER=1; shift ;;
    --game)     MARGIN=7168; CTX=8192; shift ;;
    --big)      CTX=32768; shift ;;
    --vision)   VISION=1; shift ;;
    --margin)   MARGIN="$2"; shift 2 ;;
    --ctx)      CTX="$2"; shift 2 ;;
    --think)    THINK="$2"; shift 2 ;;
    --effort)   EFFORT="$2"; shift 2 ;;
    --port)     PORT="$2"; shift 2 ;;
    --model)    MODEL="$2"; shift 2 ;;
    --)         shift; EXTRA+=("$@"); break ;;
    *)          EXTRA+=("$1"); shift ;;
  esac
done

if (( ROUTER )); then
  [[ -f "$PRESETS" ]] || { echo "нет файла пресетов: $PRESETS" >&2; exit 1; }
  printf '\n\033[1mРежим роутера\033[0m  пресеты: %s\n' "$PRESETS"
  printf 'Модели переключаются в селекторе Zed, грузятся по запросу (~8 с).\n\n'
  LOGDIR="$HOME/.local/state/qwen"; mkdir -p "$LOGDIR"
  printf 'Лог: %s   (смотреть запросы: qwen-watch)\n\n' "$LOGDIR/server.log"
  exec llama-server --models-preset "$PRESETS" --models-max 1 \
       --host "$HOST" --port "$PORT" "${EXTRA[@]}" 2>&1 | tee "$LOGDIR/server.log"
fi

[[ -f "$MODEL" ]] || { echo "нет файла модели: $MODEL" >&2; exit 1; }

read -r TOTAL USED FREE < <(
  nvidia-smi --query-gpu=memory.total,memory.used,memory.free \
             --format=csv,noheader,nounits | tr -d ',' | head -1
)

printf '\n\033[1mVRAM\033[0m   всего %s · занято %s · свободно %s MiB\n' "$TOTAL" "$USED" "$FREE"
printf '\033[1mЗапас\033[0m  %s MiB   →   бюджет ~%s MiB\n' "$MARGIN" "$(( FREE - MARGIN ))"
printf '\033[1mКонтекст\033[0m %s   \033[1mКартинки\033[0m %s\n' \
  "$CTX" "$( ((VISION)) && echo вкл || echo выкл )"

if (( FREE - MARGIN < 4096 )); then
  echo
  echo "Мало свободной VRAM. Держат её:"
  nvidia-smi | awk '/[0-9]+MiB \|$/ {next} / G  *\// {printf "  %-44s %s\n", $(NF-1), $NF}'
fi
echo

ARGS=(
  -m "$MODEL"
  --fit on --fit-target "$MARGIN" --fit-ctx 4096
  --ctx-size "$CTX"
  --parallel 1                       # без этого контекст режется на 4 слота!
  --cache-type-k q8_0 --cache-type-v q8_0
  --flash-attn on
  --reasoning "$THINK" --reasoning-effort "$EFFORT"
  --host "$HOST" --port "$PORT"
  --jinja --alias Qwen3.8-27B --metrics
)
(( VISION )) && [[ -f "$MMPROJ" ]] && ARGS+=( --mmproj "$MMPROJ" )

exec llama-server "${ARGS[@]}" "${EXTRA[@]}"
