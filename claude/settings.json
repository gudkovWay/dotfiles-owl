{
  "model": "opus",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(hyprctl:*)",
      "Bash(vulkaninfo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-claude-trailers.sh"
          }
        ]
      }
    ]
  }
}
