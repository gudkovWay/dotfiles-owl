# Ежеминутный тик: кривая рампы плавная, а минуты между тиками — тот квант,
# на котором драйвер сам решает, изменилось ли что-то (и тогда не дёргает
# железо). OnStartupSec закрывает окно после логина, когда таймер по
# календарю ещё не тикнул, а яркость может остаться с прошлого сеанса.
[Unit]
Description=Run night-mode ramp every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
OnStartupSec=15

[Install]
WantedBy=timers.target
