[Unit]
Description=Мираторг — четвёртый участник чата
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/ai/chat-bot
ExecStart=/usr/bin/python3 -m bot
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
Nice=10

[Install]
WantedBy=default.target
