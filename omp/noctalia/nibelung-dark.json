{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/modes/theme/theme-schema.json",
  "colors": {
    "accent": "emphasis",
    "bashMode": "accent-bright",
    "border": "level2",
    "borderAccent": "accent-bright",
    "borderMuted": "level1",
    "customMessageBg": "custom-message-bg",
    "customMessageLabel": "accent-bright",
    "customMessageText": "fg",
    "dim": "level3",
    "error": "rainbow-red",
    "mdCode": "level3",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "level2",
    "mdHeading": "level6",
    "mdHr": "level2",
    "mdLink": "link",
    "mdLinkUrl": "level3",
    "mdListBullet": "level4",
    "mdQuote": "level3",
    "mdQuoteBorder": "level2",
    "muted": "level4",
    "pythonMode": "accent-bright",
    "selectedBg": "accent-subtle",
    "statusLineBg": "level1",
    "statusLineContext": "level5",
    "statusLineCost": "level4",
    "statusLineDirty": "rainbow-orange",
    "statusLineGitClean": "rainbow-green",
    "statusLineGitDirty": "rainbow-orange",
    "statusLineModel": "level5",
    "statusLineOutput": "level5",
    "statusLinePath": "accent-bright",
    "statusLineSep": "level2",
    "statusLineSpend": "level5",
    "statusLineStaged": "rainbow-green",
    "statusLineSubagents": "emphasis",
    "statusLineUntracked": "rainbow-red",
    "success": "rainbow-green",
    "syntaxComment": "level3",
    "syntaxFunction": "emphasis",
    "syntaxKeyword": "level4",
    "syntaxNumber": "level4",
    "syntaxOperator": "level2",
    "syntaxPunctuation": "level2",
    "syntaxString": "level3",
    "syntaxType": "level3",
    "syntaxVariable": "level4",
    "text": "fg",
    "thinkingHigh": "accent-bright",
    "thinkingLow": "level3",
    "thinkingMedium": "accent-light",
    "thinkingMinimal": "level2",
    "thinkingOff": "level1",
    "thinkingText": "level4",
    "thinkingXhigh": "accent-match",
    "toolDiffAdded": "rainbow-green",
    "toolDiffContext": "level3",
    "toolDiffRemoved": "rainbow-red",
    "toolErrorBg": "tool-error-bg",
    "toolOutput": "fg",
    "toolPendingBg": "level0",
    "toolSuccessBg": "tool-success-bg",
    "toolTitle": "emphasis",
    "userMessageBg": "level0",
    "userMessageText": "fg",
    "warning": "rainbow-orange"
  },
  "export": {
    "cardBg": "level0",
    "infoBg": "export-info-bg",
    "pageBg": "bg"
  },
  "name": "nibelung-dark",
  "vars": {
    "accent-bright": "{{ colors.primary.default.hex }}",
    "accent-light": "{{ colors.secondary.default.hex }}",
    "accent-match": "{{ colors.tertiary.default.hex }}",
    "accent-subtle": "{{ colors.surface_container_highest.default.hex }}",
    "bg": "{{ colors.surface.default.hex }}",
    "comment-bg": "{{ colors.surface_container_low.default.hex }}",
    "custom-message-bg": "{{ colors.surface_container_high.default.hex }}",
    "emphasis": "{{ colors.tertiary.default.hex }}",
    "export-info-bg": "{{ colors.surface_container.default.hex }}",
    "fg": "{{ colors.on_surface.default.hex }}",
    "level0": "{{ colors.surface_container_low.default.hex }}",
    "level1": "{{ colors.surface_container.default.hex }}",
    "level2": "{{ colors.outline_variant.default.hex }}",
    "level3": "{{ colors.outline.default.hex }}",
    "level4": "{{ colors.on_surface_variant.default.hex }}",
    "level5": "{{ colors.on_surface.default.hex }}",
    "level6": "{{ colors.on_surface.default.hex }}",
    "link": "{{ colors.tertiary.default.hex }}",
    "rainbow-blue": "{{ colors.primary.default.hex }}",
    "rainbow-bluelight": "{{ colors.primary.default.hex }}",
    "rainbow-cyan": "{{ colors.secondary.default.hex }}",
    "rainbow-green": "{{ colors.primary.default.hex }}",
    "rainbow-magenta": "{{ colors.tertiary.default.hex }}",
    "rainbow-orange": "{{ colors.secondary.default.hex }}",
    "rainbow-red": "{{ colors.error.default.hex }}",
    "rainbow-yellow": "{{ colors.secondary.default.hex }}",
    "string-bg": "{{ colors.surface_container.default.hex }}",
    "tool-error-bg": "{{ colors.surface_container_highest.default.hex }}",
    "tool-success-bg": "{{ colors.surface_container_high.default.hex }}"
  }
}
